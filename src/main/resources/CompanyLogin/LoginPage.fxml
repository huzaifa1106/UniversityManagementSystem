<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane style="-fx-background-color: #ADD8E6;" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CompanyLogin.Controller">

   <VBox alignment="CENTER" layoutX="-19.0" prefHeight="600.0" prefWidth="800.0" spacing="15">
      <Label prefHeight="64.0" prefWidth="353.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" text="    UOFG Student Management System" textAlignment="CENTER">
         <font>
            <Font size="28.0" />
         </font></Label>

      <TextField fx:id="usernameField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="36.0" prefWidth="284.0" promptText="Username" style="-fx-pref-width: 250px; -fx-padding: 8px; -fx-font-size: 14px;">
         <font>
            <Font name="ArtifaktElement-Regular" size="12.0" />
         </font></TextField>

      <PasswordField fx:id="passwordField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="36.0" prefWidth="317.0" promptText="Password" style="-fx-pref-width: 250px; -fx-padding: 8px; -fx-font-size: 14px;" />

      <Button fx:id="loginButton" style="-fx-background-color: #0078D7; -fx-text-fill: white;                        -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-border-radius: 5px;" text="Login" />
   </VBox>
</AnchorPane>
