<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.CompanyLogin.LoginController">

   <!-- Background Image -->
   <ImageView fitHeight="625.0" fitWidth="800.0" preserveRatio="false">
      <image>
         <Image url="@guelphLogo.png" />
      </image>
   </ImageView>

   <!-- VBox for Login UI -->
   <VBox alignment="CENTER" layoutX="163.0" layoutY="136.0" prefHeight="370.0" prefWidth="500.0" spacing="15"
         style="-fx-background-color: rgba(255, 255, 255, 0.8); -fx-padding: 20px; -fx-background-radius: 10px;">

      <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;" text="UOFG Student Management System" />

      <TextField fx:id="usernameField" promptText="Username" style="-fx-pref-width: 250px; -fx-padding: 8px; -fx-font-size: 14px;" />

      <PasswordField fx:id="passwordField" promptText="Password" style="-fx-pref-width: 250px; -fx-padding: 8px; -fx-font-size: 14px;" />

      <!-- Ensure the Button has onAction calling handleLogin() -->
      <Button fx:id="loginButton"
              text="Login"
              style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-border-radius: 5px;"
              onAction="#handleLogin"/>
   </VBox>

</AnchorPane>
