<?xml version="1.0" encoding="UTF-8"?>

<!--
 File Name: FCourseManageEnrollments.fxml
 Description: Faculty view to manage enrollments in a selected course.
 Author: Huzaifa A. & Group
 Date: April 3rd, 2025
 -->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.14-internal"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.CompanyLogin.FCourseManageEnrollmentsController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <Label fx:id="courseTitleLabel" text="Managing Enrollments" style="-fx-font-size: 20px; -fx-padding: 10px; -fx-font-weight: bold;" />
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20px;">
            <Label text="Enrolled Students:" style="-fx-font-weight: bold;" />
            <ListView fx:id="studentListView" prefHeight="200.0" />
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10px;">
            <Button text="Close" onAction="#closeWindow" />
        </HBox>
    </bottom>
</BorderPane>
