<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f8f9fa;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.CompanyLogin.ACourseManagementController">


    <left>
        <VBox spacing="12" style="-fx-background-color: #6A89A7; -fx-padding: 10px;" BorderPane.alignment="CENTER">
            <ImageView fitHeight="70.0" fitWidth="155.0">
                <image>
                    <Image url="@HomeScreen.png" />
                </image>
            </ImageView>
            <Button onAction="#loadDashboard" prefHeight="62.0" prefWidth="147.0" text="Dashboard" />
            <Button onAction="#loadSubjectManagement" prefHeight="62.0" prefWidth="147.0" text="Subject Management" />
            <Button onAction="#loadCourseManagement" prefHeight="69.0" prefWidth="146.0" text="Course Management" />
            <Button onAction="#loadStudentManagement" prefHeight="68.0" prefWidth="147.0" text="Student Management" />
            <Button onAction="#loadFacultyManagement" prefHeight="69.0" prefWidth="145.0" text="Faculty Management" />
            <Button onAction="#loadEventManagement" prefHeight="76.0" prefWidth="146.0" text="Event Management" />
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20px;">
            <Label text="Admin Course Management" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            <Label text="Manage Courses" style="-fx-font-size: 17px; -fx-font-weight: bold;" />

            <!-- Scrollable Form -->
            <ScrollPane fitToWidth="true" prefHeight="300">
                <content>
                    <GridPane fx:id="courseForm" hgap="20" vgap="10"
                              style="-fx-background-color: white; -fx-padding: 15px; -fx-border-color: lightgray; -fx-border-width: 1;"
                              prefWidth="600.0">
                        <Label text="Course Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;" />
                        <TextField fx:id="courseNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Course ID:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                        <TextField fx:id="courseIDField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Section Number:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;" />
                        <TextField fx:id="sectionField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Instructor:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;" />
                        <ComboBox fx:id="instructorComboBox" promptText="Select Instructor" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Subject Name:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;" />
                        <ComboBox fx:id="subjectComboBox" promptText="Select Subject" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Label text="Location:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                        <TextField fx:id="locationField" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <Label text="Lecture Day:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: bold;" />
                        <ComboBox fx:id="lectureDayComboBox" promptText="Select Lecture Day(s)" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                        <Label text="Final Exam Date:" GridPane.columnIndex="2" GridPane.rowIndex="3" style="-fx-font-weight: bold;" />
                        <DatePicker fx:id="finalExamDatePicker" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                        <Label text="Start Time (HHMM):" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;" />
                        <TextField fx:id="startTimeField" promptText="e.g. 900" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                        <Label text="End Time (HHMM):" GridPane.columnIndex="2" GridPane.rowIndex="4" style="-fx-font-weight: bold;" />
                        <TextField fx:id="endTimeField" promptText="e.g. 1100" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                    </GridPane>
                </content>
            </ScrollPane>

            <Button fx:id="addCourseButton" text="Add Course" onAction="#addCourse" style="-fx-font-weight: bold;" />

            <Label text="Course List" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <TableView fx:id="courseDetailsTable" prefHeight="200.0" prefWidth="600.0">
                <columns>
                    <TableColumn fx:id="colCourseID" text="Course ID" prefWidth="100.0"/>
                    <TableColumn fx:id="colCourseName" text="Course Name" prefWidth="150.0"/>
                    <TableColumn fx:id="colSectionNumber" text="Section" prefWidth="100.0"/>
                    <TableColumn fx:id="colTeacherName" text="Instructor" prefWidth="150.0"/>
                    <TableColumn fx:id="colSubjectName" text="Subject Name" prefWidth="150.0"/>
                    <TableColumn fx:id="colLocation" text="Location" prefWidth="150.0"/>
                    <TableColumn fx:id="colLectureDay" text="Lecture Day" prefWidth="100.0"/>
                    <TableColumn fx:id="colLectureTime" text="Time" prefWidth="150.0"/>
                    <TableColumn fx:id="colFinalExamDate" text="Final Exam" prefWidth="150.0"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10px;">
                <Button fx:id="editCourseButton" text="Edit Course" onAction="#editCourse" prefWidth="130.0"/>
                <Button fx:id="deleteCourseButton" text="Delete Course" onAction="#deleteCourse" prefWidth="130.0"/>
                <Button fx:id="manageEnrollmentsButton" text="Manage Enrollments" onAction="#manageEnrollments" prefWidth="150.0"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
