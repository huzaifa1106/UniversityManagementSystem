<?xml version="1.0" encoding="UTF-8"?>

<!--
 File Name: AEventManagement.fxml
 Description: This is the AEventManagement FXML file to assist with front-end development
 Date: March 2nd, 2025
 -->

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.CompanyLogin.AEventManagementController">

    <left>
        <VBox spacing="10" style="-fx-background-color: #6A89A7; -fx-padding: 10px;" BorderPane.alignment="CENTER">
            <ImageView fitHeight="70.0" fitWidth="155.0">
                <image>
                    <Image url="@HomeScreen.png" />
                </image>
            </ImageView>
            <Button mnemonicParsing="false" prefHeight="63.0" prefWidth="148.0" text="Dashboard" />
            <Button onAction="#loadSubjectManagement" prefHeight="62.0" prefWidth="147.0" text="Subject Management" />
            <Button onAction="#loadCourseManagement" prefHeight="69.0" prefWidth="146.0" text="Course Management" />
            <Button onAction="#loadStudentManagement" prefHeight="68.0" prefWidth="147.0" text="Student Management" />
            <Button onAction="#loadFacultyManagement" prefHeight="69.0" prefWidth="145.0" text="Faculty Management" />
            <Button onAction="#loadEventManagement" prefHeight="76.0" prefWidth="146.0" text="Event Management" />
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10px;">
            <HBox alignment="CENTER" spacing="10">
                <Button onAction="#previousYear" text="<< Year" />
                <Button onAction="#previousMonth" text="< Month" />
                <Label fx:id="monthYearLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="March 2025" />
                <Button onAction="#nextMonth" text="Month >" />
                <Button onAction="#nextYear" text="Year >>" />
            </HBox>

            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Event Calendar (Next 30 Days)" />
            <GridPane fx:id="calendarGrid" hgap="10" prefHeight="430.0" prefWidth="435.0" style="-fx-padding: 10px;" vgap="10">
                <!-- Calendar Days will be dynamically added here -->
            </GridPane>
        </VBox>
    </center>

    <right>
        <VBox alignment="CENTER" prefHeight="600.0" prefWidth="263.0" spacing="12" style="-fx-padding: 15px;">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Create an Event" />

            <GridPane hgap="15" prefHeight="276.0" prefWidth="203.0" vgap="12">
                <Label style="-fx-font-weight: bold;" text="Event Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="eventNameField" promptText="Enter Event Name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label style="-fx-font-weight: bold;" text="Event Code:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="eventCodeField" promptText="Enter Event Code" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label style="-fx-font-weight: bold;" text="Location:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="eventLocationField" promptText="Enter Venue" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label style="-fx-font-weight: bold;" text="Date - Time:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="eventDateTimeField" promptText="Date and Time" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label style="-fx-font-weight: bold;" text="Capacity:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="eventCapacityField" promptText="Max Participants" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label style="-fx-font-weight: bold;" text="Cost:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextField fx:id="eventCostField" promptText="Enter Cost" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </GridPane>

            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="addEventButton" onAction="#addEvent" prefHeight="30.0" prefWidth="90.0" text="Add Event" />
                <Button fx:id="editEventButton" onAction="#editEvent" prefHeight="30.0" prefWidth="90.0" text="Edit Event" />
            </HBox>
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="deleteEventButton" onAction="#deleteEvent" prefHeight="34.0" prefWidth="89.0" text="Delete Event" />
                <Button fx:id="viewEventsButton" onAction="#viewEvents" prefHeight="34.0" prefWidth="87.0" text="View Events" />
            </HBox>
        </VBox>
    </right>
</BorderPane>
