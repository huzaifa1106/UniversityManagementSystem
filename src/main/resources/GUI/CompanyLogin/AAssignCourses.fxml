<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="400.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.CompanyLogin.AAssignCoursesController">

    <children>
        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="35.0" prefWidth="603.0" text="Assign Courses to Faculty" textAlignment="RIGHT">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <TableView fx:id="courseTable" prefHeight="200.0" prefWidth="580.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCourseName" prefWidth="60.0" text="Course Name" />
                <TableColumn fx:id="colCourseID" prefWidth="50.0" text="Course ID" />
                <TableColumn fx:id="colSection" prefWidth="50.0" text="Section" />
                <TableColumn fx:id="colSubject" text="Subject" />
            <TableColumn fx:id="colInstructor" prefWidth="50.0" text="Assigned Inst." />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
      <HBox alignment="CENTER">
         <children>
      
              <Button fx:id="assignButton" mnemonicParsing="false" onAction="#assignSelectedCourse" text="Re-assign courses to selected faculty" />
         </children>
      </HBox>
    </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
</VBox>
