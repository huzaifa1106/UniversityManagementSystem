<?xml version="1.0" encoding="UTF-8"?>

<!--
 File Name: ASubjectManagement.fxml
 Description: This is the ASubjectManagement FXML file to assist with front-end development
 Date: March 2nd, 2025
 -->

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: #f8f9fa;"
            xmlns="http://javafx.com/javafx/11.0.14-internal"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.CompanyLogin.ASubjectManagementController">

    <!-- Sidebar Menu -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #6A89A7; -fx-padding: 10px;" BorderPane.alignment="CENTER">
            <ImageView fitHeight="70.0" fitWidth="155.0">
                <image>
                    <Image url="@HomeScreen.png" />
                </image>
            </ImageView>
            <Button mnemonicParsing="false" onAction="#loadDashboard" prefHeight="63.0" prefWidth="150.0" text="Dashboard" />
            <Button onAction="#loadSubjectManagement" prefHeight="62.0" prefWidth="147.0" text="Subject Management" />
            <Button onAction="#loadCourseManagement" prefHeight="69.0" prefWidth="146.0" text="Course Management" />
            <Button onAction="#loadStudentManagement" prefHeight="68.0" prefWidth="147.0" text="Student Management" />
            <Button onAction="#loadFacultyManagement" prefHeight="69.0" prefWidth="145.0" text="Faculty Management" />
            <Button onAction="#loadEventManagement" prefHeight="76.0" prefWidth="146.0" text="Event Management" />
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20px;">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 5px;" text="Admin Subject Management" />

            <!-- 🔹 Subject Input Form (Now Added) -->
            <GridPane hgap="20" vgap="10" prefHeight="100.0" prefWidth="600.0"
                      style="-fx-background-color: white; -fx-padding: 15px; -fx-border-color: lightgray; -fx-border-width: 1;">

                <Label text="Subject Name:" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="subjectNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Subject Code (Optional):" style="-fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="subjectCodeField" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            </GridPane>

            <!-- 🔹 Add Subject Button -->
            <Button fx:id="addButton" onAction="#addSubject" style="-fx-font-weight: bold;" text="Add Subject" />

            <!-- 🔹 Table: Subject List -->
            <TableView fx:id="subjectTable" prefHeight="300.0" prefWidth="600.0">
                <columns>
                    <TableColumn fx:id="colSubjectCode" text="Subject Code" prefWidth="150.0"/>
                    <TableColumn fx:id="colSubjectName" text="Subject Name" prefWidth="452.8"/>
                </columns>
            </TableView>

            <!-- 🔹 Action Buttons -->
            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10px;">
                <Button fx:id="editButton" onAction="#editSubject" prefHeight="35.0" prefWidth="140.0" text="Edit Subject" />
                <Button fx:id="deleteButton" onAction="#deleteSubject" prefHeight="35.0" prefWidth="140.0" text="Delete Subject" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
