<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/11.0.14-internal"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.CompanyLogin.UCourseManagementController">

    <left>
        <VBox spacing="10" style="-fx-background-color: #6A89A7; -fx-padding: 10px;" BorderPane.alignment="CENTER">
            <ImageView fitHeight="70.0" fitWidth="155.0">
                <image>
                    <Image url="@HomeScreen.png" />
                </image>
            </ImageView>
            <Button layoutX="10.0" layoutY="98.0" onAction="#loadSubjectManagement" prefHeight="62.0" prefWidth="147.0" styleClass="menu-button" text="Subject Management" />
            <Button layoutX="10.0" layoutY="171.0" onAction="#loadCourseManagement" prefHeight="69.0" prefWidth="146.0" styleClass="menu-button" text="Course Management" />
            <Button layoutX="11.0" layoutY="254.0" onAction="#loadStudentManagement" prefHeight="68.0" prefWidth="147.0" styleClass="menu-button" text="Student Management" />
            <Button layoutX="12.0" layoutY="336.0" onAction="#loadFacultyManagement" prefHeight="69.0" prefWidth="145.0" styleClass="menu-button" text="Faculty Management" />
            <Button layoutX="11.0" layoutY="419.0" onAction="#loadEventManagement" prefHeight="76.0" prefWidth="146.0" styleClass="menu-button" text="Event Management" />

        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20px;">
            <Label text="Course Management" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 5px;" />

            <Label text="Enrolled Courses" style="-fx-font-size: 18px; -fx-font-weight: bold;" />


            <TableView fx:id="enrolledCoursesTable" prefHeight="200.0" prefWidth="600.0">
                <columns>
                    <TableColumn fx:id="colCourseID" text="Course ID" prefWidth="100.0" />
                    <TableColumn fx:id="colCourseName" text="Course Name" prefWidth="200.0" />
                    <TableColumn fx:id="colSectionNumber" text="Section" prefWidth="100.0" />
                    <TableColumn fx:id="colTeacherName" text="Instructor" prefWidth="200.0" />
                </columns>
            </TableView>

            <Label text="Course Offerings" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <TableView fx:id="courseDetailsTable" prefHeight="200.0" prefWidth="600.0">
                <columns>
                    <TableColumn fx:id="colSubjectName" text="Subject Name" prefWidth="150.0" />
                    <TableColumn fx:id="colLocation" text="Location" prefWidth="150.0" />
                    <TableColumn fx:id="colLectureDay" text="Lecture Day" prefWidth="100.0" />
                    <TableColumn fx:id="colLectureTime" text="Time" prefWidth="150.0" />
                    <TableColumn fx:id="colFinalExamDate" text="Final Exam" prefWidth="150.0" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
