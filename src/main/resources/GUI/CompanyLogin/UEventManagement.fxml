<?xml version="1.0" encoding="UTF-8"?>

<!--
 File Name: UEventManagement.fxml
 Description: Calendar view + student event registration system.
 Updated: April 4th, 2025
-->

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.14-internal"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.CompanyLogin.UEventManagementController"
            prefHeight="600.0" prefWidth="880.0"
            style="-fx-background-color: #f8f9fa;">

    <left>
        <VBox spacing="10" style="-fx-background-color: #6A89A7; -fx-padding: 10px;" BorderPane.alignment="CENTER">
            <ImageView fitHeight="70.0" fitWidth="155.0">
                <image>
                    <Image url="@HomeScreen.png" />
                </image>
            </ImageView>
            <Button text="Subject Management" prefWidth="150.0" onAction="#loadSubjectManagement"/>
            <Button text="Course Management" prefWidth="150.0" onAction="#loadCourseManagement"/>
            <Button text="Student Management" prefWidth="150.0" onAction="#loadStudentManagement"/>
            <Button text="Faculty Management" prefWidth="150.0" onAction="#loadFacultyManagement"/>
            <Button text="Event Management" prefWidth="150.0" onAction="#loadEventManagement"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10px;">
            <HBox alignment="CENTER" spacing="10">
                <Button text="&lt; Previous" onAction="#previousMonth"/>
                <Label fx:id="monthYearLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <Button text="Next &gt;" onAction="#nextMonth"/>
            </HBox>

            <Label text="Available Events Calendar" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            <GridPane fx:id="calendarGrid" hgap="5" vgap="5" prefHeight="420.0" prefWidth="440.0" style="-fx-padding: 10px;">
                <!-- Calendar days populate dynamically -->
            </GridPane>
        </VBox>
    </center>

    <right>
        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 20px;">
            <Label text="Register for an Event" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <TextField fx:id="eventCodeField" promptText="Enter Event Code"/>
            <Button text="Register" onAction="#onRegisterButtonClicked" />
        </VBox>
    </right>

</BorderPane>
