<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.CompanyLogin.FUserManagementController">

    <left>
        <VBox spacing="10" style="-fx-background-color: #6A89A7; -fx-padding: 10px;" BorderPane.alignment="CENTER">
            <ImageView fitHeight="70.0" fitWidth="155.0">
                <image>
                    <Image url="@HomeScreen.png" />
                </image>
            </ImageView>
            <Button onAction="#loadCourseManagement" prefHeight="69.0" prefWidth="146.0" text="Course Management" />
            <Button onAction="#loadUserManagement" prefHeight="68.0" prefWidth="147.0" text="User Management" />
            <Button onAction="#loadEventManagement" prefHeight="76.0" prefWidth="146.0" text="Event Management" />
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20px;">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Faculty Profile" />

            <Pane prefHeight="130.0" prefWidth="600.0" style="-fx-background-color: #ffffff; -fx-border-color: lightgray; -fx-border-width: 1; -fx-padding: 10px;">
                <children>
                    <Label layoutX="14.0" layoutY="14.0" style="-fx-font-weight: bold;" text="Full Name:" />
                    <Label fx:id="facultyNameLabel" layoutX="90.0" layoutY="14.0" text="Dr. Faculty" />

                    <Label layoutX="14.0" layoutY="34.0" style="-fx-font-weight: bold;" text="Email:" />
                    <Label fx:id="facultyEmailLabel" layoutX="90.0" layoutY="34.0" text="faculty@university.ca" />

                    <Label layoutX="14.0" layoutY="54.0" style="-fx-font-weight: bold;" text="Degree:" />
                    <Label fx:id="facultyDegreeLabel" layoutX="90.0" layoutY="54.0" text="Ph.D" />

                    <Label layoutX="14.0" layoutY="74.0" style="-fx-font-weight: bold;" text="Office Location:" />
                    <Label fx:id="facultyOfficeLabel" layoutX="130.0" layoutY="74.0" text="Room 101" />

                    <Label layoutX="280.0" layoutY="14.0" style="-fx-font-weight: bold;" text="Research Interest:" />
                    <Label fx:id="facultyResearchLabel" layoutX="410.0" layoutY="14.0" text="AI and Machine Learning" />

                    <Label layoutX="280.0" layoutY="34.0" style="-fx-font-weight: bold;" text="Courses Assigned:" />
                    <Label fx:id="facultyCoursesLabel" layoutX="410.0" layoutY="34.0" text="Programming 101, Systems" />

                    <ImageView fitHeight="70.0" fitWidth="70.0" layoutX="428.0" layoutY="56.0">
                        <image>
                            <Image url="@ProfilePicture.jpg" />
                        </image>
                    </ImageView>
                </children>
            </Pane>

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Courses List" />
            <TableView fx:id="facultyCourseTable" prefHeight="180.0" prefWidth="600.0">
                <columns>
                    <TableColumn fx:id="colCourseID" prefWidth="120.0" text="Course ID" />
                    <TableColumn fx:id="colCourseName" prefWidth="180.0" text="Course Name" />
                    <TableColumn fx:id="colSectionID" prefWidth="120.0" text="Section ID" />
                    <TableColumn fx:id="colLocation" prefWidth="180.0" text="Location" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
